{
    // LaTeX Workshop: build the Prac 2 report with latexmk (pdfLaTeX + Biber).
    // Build files and the PDF go to Practical_2/Report/build/ (git-ignored).
    "latex-workshop.latex.outDir": "%DIR%/build",
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk (pdfLaTeX + Biber)",
            "tools": ["latexmk"]
        }
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk",
            "command": "latexmk",
            "args": [
                "-pdf",
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ]
        }
    ],
    "latex-workshop.latex.recipe.default": "first",
    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.latex.autoClean.run": "never",
    "latex-workshop.view.pdf.viewer": "tab",
    // Always build the whole report, even when saving a file in sections/.
    "latex-workshop.latex.rootFile.useSubFile": false,
    "latex-workshop.latex.search.rootFiles.include": [
        "Practical_2/Report/main.tex"
    ]
}
